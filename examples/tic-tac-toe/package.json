{
  "name": "tic-tac-toe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORTLESS_PORT=443 PORTLESS_HTTPS=1 PORTLESS_WILDCARD=1 portless",
    "dev:app": "vite dev",
    "zerospin:dev": "zerospin dev --port ${ZEROSPIN_PORT:-12003}",
    "ts": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src --format stylish",
    "studio": "PORTLESS_PORT=443 PORTLESS_HTTPS=1 portless studio.tic-tac-toe --app-port 12031 zerospin studio --port 12031"
  },

    "@libp2p/interface": "^3.4.0",
    "@libp2p/noise": "^17.0.7",
    "@libp2p/peer-id": "^6.0.18",
    "@libp2p/websockets": "^10.1.25",
    "@libp2p/yamux": "^8.0.7",
    "@multiformats/multiaddr": "^13.0.3",
    "@remix-run/route-pattern": "^0.22.1",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@zerospin/browser": "workspace:*",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/native": "workspace:*",

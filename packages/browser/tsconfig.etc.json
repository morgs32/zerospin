{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "rootDir": "../..",
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "tsup.config.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../core"
    },
    {
      "path": "../error"
    },
    {
      "path": "../logger"
    },
    {
      "path": "../shapes"
    },
    {
      "path": "../system-worker"
    }
  ],
  "exclude": []
}

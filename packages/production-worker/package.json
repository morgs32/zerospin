    "cloudflare": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "effect": "4.0.2",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "effect": "^4.0.2"
  }

{
  "name": "@zerospin/production-worker",
  "version": "1.0.0-alpha.11",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./SystemWorker": {
      "types": "./dist/SystemWorker.d.ts",
      "import": "./dist/SystemWorker.js",
      "default": "./dist/SystemWorker.js"

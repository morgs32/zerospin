{
  "name": "@zerospin/system-diagrams",
  "version": "1.0.0-alpha.11",
  "private": false,
  "description": "React declaration board for authored Zerospin system metadata",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run lib",
    "format": "oxfmt package.json project.json tsconfig.json src README.md",
    "format:check": "oxfmt --check package.json project.json tsconfig.json src README.md",
    "lint": "oxlint src --format stylish"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@zerospin/core": "workspace:*",
    "es-toolkit": "^1.52.0",
    "react-resizable-panels": "^4.15.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "oxlint": "^1.63.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "react": ">=19 <19.3",
    "react-dom": ">=19 <19.3"
  }
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/core",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/shapes",
            "@zerospin/server-only"
          ]
        }
      ]
    },
    "watch": {
      "continuous": true
    },
    "dev": {
      "continuous": true
    }
  }
}

{
  "name": "@zerospin/owner-release-worker",
  "version": "1.0.0-alpha.11",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./AggregateReleaseWorker": {
      "types": "./dist/AggregateReleaseWorker.d.ts",
      "import": "./dist/AggregateReleaseWorker.js",
      "default": "./dist/AggregateReleaseWorker.js"
    },
    "./ServiceReleaseWorker": {
      "types": "./dist/ServiceReleaseWorker.d.ts",
      "import": "./dist/ServiceReleaseWorker.js",
      "default": "./dist/ServiceReleaseWorker.js"
    },
    "./VersionRepos": {
      "types": "./dist/VersionRepos.d.ts",
      "import": "./dist/VersionRepos.js",
      "default": "./dist/VersionRepos.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/shapes": "workspace:*",
    "@zerospin/system-worker": "workspace:*",
    "capnweb": "^0.12.0",
    "drizzle-orm": "1.0.0-rc.6",
    "es-toolkit": "^1.46.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "effect": "4.0.2",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "effect": "^4.0.2"
  }
}

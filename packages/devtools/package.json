{
  "name": "@zerospin/devtools",
  "version": "1.0.0-alpha.11",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/types.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/live-query": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "react-router": "^7.15.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "effect": "4.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "^6.1.3",
    "vite": "^8.0.11"
  },
  "peerDependencies": {
    "effect": "^4.0.2",
    "react": ">=18",
    "react-dom": ">=18"
  }
}

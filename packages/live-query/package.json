{
  "name": "@zerospin/live-query",
  "version": "1.0.0-alpha.11",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/makeLiveQuery.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/core": "workspace:*",
    "drizzle-orm": "1.0.0-rc.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/node": "^25.6.2",
    "@zerospin/shapes": "workspace:*",
    "effect": "4.0.2",
    "rimraf": "^6.1.3",
    "vite": "^8.0.11"
  }
}

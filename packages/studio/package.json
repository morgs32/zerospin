{
  "name": "@zerospin/studio",
  "version": "1.0.0-alpha.11",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "vite.config.ts"
  ],
  "exports": {
    "./startStudio": {
      "types": "./dist/startStudio.d.ts",
      "import": "./dist/startStudio.js",
      "default": "./dist/startStudio.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.etc.json --noEmit",
    "prepublishOnly": "pnpm run lib",
    "format": "oxfmt package.json project.json tsconfig.json tsconfig.etc.json vite.config.ts src .storybook stories",
    "format:check": "oxfmt --check package.json project.json tsconfig.json tsconfig.etc.json vite.config.ts src .storybook stories",
    "lint": "oxlint src vite.config.ts .storybook stories --ignore-pattern '**/mockServiceWorker.js' --format stylish && oxlint -c shadcn.oxlintrc.json src stories --format stylish",
    "storybook": "storybook dev --port ${PORT:-12021} --no-open --exact-port"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "@zerospin/browser": "workspace:*",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/shapes": "workspace:*",
    "@zerospin/system-diagrams": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-webpack": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.11"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@shadcn/lint": "0.2.5",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "effect": "4.0.2",
    "msw": "3.0.2",
    "msw-storybook-addon": "3.0.3",
    "oxlint": "1.87.0",
    "rimraf": "^6.1.3",
    "storybook": "10.6.1"
  },
  "peerDependencies": {
    "effect": "^4.0.2"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}

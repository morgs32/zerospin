{
  "name": "@zerospin/react",
  "version": "1.0.0-alpha.11",
  "private": false,
  "description": "Zerospin React session hooks and shape-generated forms",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ZerospinProviderContext": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    },
    "./primitives.css": "./dist/primitives.css",
    "./primitives/*": null
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "node scripts/build.mjs",
    "ts": "tsc -p tsconfig.json --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@remix-run/route-pattern": "^0.22.1",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-form": "^1.33.5",
    "@zerospin/browser": "workspace:*",
    "@zerospin/core": "workspace:*",
    "@zerospin/devtools": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/live-query": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/sdk": "workspace:*",
    "@zerospin/shapes": "workspace:*",
    "capnweb": "^0.12.0",
    "client-only": "^0.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.6",
    "es-toolkit": "^1.52.0",
    "lucide-react": "^1.24.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/language-service": "^0.87.2",
    "@effect/opentelemetry": "4.0.2",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@stylexjs/babel-plugin": "0.19.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "effect": "4.0.2",
    "knip": "^6.12.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "^4.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "effect": "^4.0.2",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "files": [
    "dist",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morgs32/zerospin.git",
    "directory": "packages/react"
  },
  "keywords": [
    "tanstack-intent"
  ]
}

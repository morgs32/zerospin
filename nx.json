{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "migrate": {
    "agentic": "codex",
    "createCommits": true
  },
  "plugins": [
    {
      "plugin": "nx/plugins/package-json",
      "exclude": ["vendor/**"]
    },
    {
      "plugin": "@nx/js/typescript",
      "exclude": ["vendor/**"],
      "options": {
        "typecheck": {
          "targetName": "tsc:typecheck"
        },
        "build": false
      }
    }
  ],
  "targetDefaults": {
    "dev": {
      "dependsOn": ["^lib"],
      "continuous": true
    },
    "build": {
      "dependsOn": ["^lib"],
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lib": {
      "dependsOn": ["^lib"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsup.config.ts",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "ts": {
      "cache": true,
      "dependsOn": ["lib", "^lib"],
      "inputs": ["default", "{projectRoot}/tsconfig*.json"]
    },
    "deploy": {
      "dependsOn": ["^lib"]
    },
    "nx-release-publish": {
      "cache": false,
      "options": {
        "registry": "http://127.0.0.1:4873/"
      }
    }
  },
  "analytics": true,
  "nxCloudId": "6a8ca057e6767a71a0a24c46",
  "release": {
    "groups": {
      "zerospin": {
        "projects": [
          "@zerospin/agent-worker",
          "@zerospin/browser",
          "@zerospin/cli",
          "@zerospin/core",
          "@zerospin/dev-worker",
          "@zerospin/devtools",
          "@zerospin/error",
          "@zerospin/error-boundary",
          "@zerospin/live-query",
          "@zerospin/logger",
          "@zerospin/native",
          "@zerospin/owner-release-worker",
          "@zerospin/production-worker",
          "@zerospin/react",
          "@zerospin/sdk",
          "@zerospin/server-only",
          "@zerospin/shapes",
          "@zerospin/studio",
          "@zerospin/system-diagrams",
          "@zerospin/system-worker",
          "@zerospin/zod",
          "@zerospin/machine"
        ],
        "projectsRelationship": "fixed",
        "changelog": false
      }
    },
    "versionPlans": true,
    "version": {
      "currentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": true,
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false,
        "renderOptions": {
          "commitReferences": false
        }
      },
      "projectChangelogs": false,
      "automaticFromRef": true
    },
    "git": {
      "commit": false,
      "tag": false,
      "push": false,
      "stageChanges": false
    }
  }
}
